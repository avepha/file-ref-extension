{
  "name": "file-reference",
  "displayName": "File Reference",
  "description": "Copy AI-friendly file references from the active editor.",
  "version": "0.0.1",
  "publisher": "farhan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fileReference.copyAbsoluteReference",
        "title": "File Reference: Copy Absolute Reference"
      },
      {
        "command": "fileReference.copyRelativeReference",
        "title": "File Reference: Copy Relative Reference"
      }
    ],
    "keybindings": [
      {
        "command": "fileReference.copyAbsoluteReference",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && !editorReadonly && resourceScheme == file"
      },
      {
        "command": "fileReference.copyRelativeReference",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus && !editorReadonly && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "compile-tests": "tsc --outDir .build",
    "test": "npm run compile-tests && mocha \".build/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.5",
    "typescript": "^5.9.2"
  }
}

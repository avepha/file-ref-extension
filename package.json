{
  "name": "file-reference",
  "displayName": "File Reference",
  "description": "Copy AI-friendly file references from the active editor.",
  "version": "1.0.1",
  "publisher": "avepha",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/avepha/file-ref-extension.git"
  },
  "bugs": {
    "url": "https://github.com/avepha/file-ref-extension/issues"
  },
  "homepage": "https://github.com/avepha/file-ref-extension#readme",
  "icon": "media/icon.png",
  "pricing": "Free",
  "keywords": [
    "ai",
    "claude-code",
    "opencode",
    "file-reference",
    "path",
    "clipboard"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fileReference.copyAbsoluteReference",
        "title": "File Reference: Copy Absolute Path with Line"
      },
      {
        "command": "fileReference.copyRelativeReference",
        "title": "File Reference: Copy Relative Path with Line"
      }
    ],
    "keybindings": [
      {
        "command": "fileReference.copyAbsoluteReference",
        "key": "ctrl+alt+shift+c",
        "mac": "alt+shift+c",
        "when": "editorTextFocus && !isInDiffEditor && resourceScheme == file"
      },
      {
        "command": "fileReference.copyRelativeReference",
        "key": "ctrl+alt+c",
        "mac": "alt+c",
        "when": "editorTextFocus && !isInDiffEditor && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "audit:check": "npm audit --audit-level=high",
    "build": "node esbuild.js",
    "clean:build": "rm -rf .build",
    "typecheck": "tsc --noEmit",
    "compile-tests": "npm run clean:build && tsc --outDir .build",
    "test": "npm run compile-tests && mocha \".build/test/**/*.test.js\"",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "package:inspect": "node scripts/inspect-vsix.js",
    "publish:marketplace": "vsce publish",
    "publish:marketplace:vsix": "node scripts/publish-vsix.js marketplace",
    "publish:openvsx": "ovsx publish",
    "publish:openvsx:vsix": "node scripts/publish-vsix.js openvsx",
    "release:check": "npm run build && npm run typecheck && npm run test && npm run audit:check && npm run package && npm run package:inspect",
    "release:publish": "npm run release:check && npm run publish:marketplace:vsix && npm run publish:openvsx:vsix",
    "release": "npx --yes -p semantic-release@24.2.9 -p @semantic-release/changelog@6.0.3 -p @semantic-release/commit-analyzer@13.0.1 -p @semantic-release/exec@7.1.0 -p @semantic-release/git@10.0.1 -p @semantic-release/github@11.0.6 -p @semantic-release/release-notes-generator@14.1.0 semantic-release"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.5",
    "ovsx": "^0.10.11",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.4",
      "serialize-javascript": "7.0.5"
    }
  }
}
